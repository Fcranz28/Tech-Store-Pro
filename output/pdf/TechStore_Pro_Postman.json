{
  "info": {
    "name": "TechStore Pro - Anexo de evaluación de devoluciones",
    "description": "Ejecutar manualmente en una base de pruebas. Los POST/PATCH modifican datos. Configurar credenciales e IDs propios; no ejecutar toda la colección de una vez: aprobación y rechazo son recorridos alternativos. Los casos no fueron ejecutados para elaborar el informe. El cliente demo tiene una solicitud RECHAZADA, terminal. Crear una nueva para probar el workflow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://techstore-pro-backend.onrender.com"
    },
    {
      "key": "clienteToken",
      "value": ""
    },
    {
      "key": "operadorToken",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": "1"
    },
    {
      "key": "pedidoDetalleId",
      "value": "1"
    },
    {
      "key": "devolucionId",
      "value": ""
    },
    {
      "key": "clienteEmail",
      "value": ""
    },
    {
      "key": "clientePassword",
      "value": ""
    },
    {
      "key": "operadorEmail",
