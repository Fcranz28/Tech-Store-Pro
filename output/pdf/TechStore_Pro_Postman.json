                "exec": [
                  "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cliente - Solicitar devolución",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clienteToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"pedidoId\":{{pedidoId}},\"motivo\":\"PRODUCTO_DEFECTUOSO\",\"comentario\":\"No funciona\",\"items\":[{\"pedidoDetalleId\":{{pedidoDetalleId}},\"cantidad\":1}]}"
            },
            "url": "{{baseUrl}}/devoluciones"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Creada\", () => pm.response.to.have.status(201));",
                  "if(pm.response.code === 201) { const id=String(pm.response.json().id); pm.collectionVariables.set(\"devolucionId\",id); pm.collectionVariables.set(\"devolucionSolicitadaId\",id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Cliente - Mis solicitudes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clienteToken}}"
              }
            ],
            "url": "{{baseUrl}}/devoluciones"
          },
          "event": [
