            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{operadorToken}}"
              }
            ],
            "url": "{{baseUrl}}/devoluciones/gestion?estado=SOLICITADA&pagina=0&tamanio=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP esperado\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
