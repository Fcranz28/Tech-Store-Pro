{
  "info": {
    "name": "TechStore Pro — API local",
    "description": "Pruebas de la API Spring Boot. Importa el entorno local y consulta docs/postman/README.md. Las solicitudes de escritura modifican la base local. Ejecuta las carpetas manualmente en el orden descrito; no ejecutes toda la colección como una sola secuencia.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set(\"guestTokenJson\", JSON.stringify(pm.environment.get(\"guestToken\") || null));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Catálogo público",
      "item": [
        {
          "name": "Listar productos y seleccionar uno con stock",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/productos",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Respuesta JSON\", () => pm.response.to.be.json);",
                  "if (pm.response.code === 200) { const d = pm.response.json(); pm.test(\"Lista de productos\", () => pm.expect(d).to.be.an(\"array\")); const p = d.find(p => p.stock > 0); if (p) pm.environment.set(\"productId\", p.id); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Detalle de producto",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/productos/{{productId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Respuesta JSON\", () => pm.response.to.be.json);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Catálogo paginado y filtros",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/productos/catalogo?pagina=0&tamanio=8&orden=precio-asc&precioMin=0&precioMax=500&disponible=true",
            "description": "Filtros adicionales: categoria=TECLADOS, q=teclado, destacado=true. Órdenes: recientes, precio-asc, precio-desc, nombre. Pagina comienza en 0; tamanio: 1–48."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Respuesta JSON\", () => pm.response.to.be.json);",
                  "if (pm.response.code === 200) { const d = pm.response.json(); pm.test(\"Catálogo paginado\", () => { pm.expect(d.productos).to.be.an(\"array\"); pm.expect(d).to.have.property(\"totalPaginas\"); pm.expect(d.categorias).to.be.an(\"array\"); }); }"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "02 Autenticación de usuario",
      "item": [
        {
          "name": "01 Registrar usuario de prueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Postman\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get(\"userEmail\")) pm.environment.set(\"userEmail\", \"postman.\" + Date.now() + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Respuesta JSON\", () => pm.response.to.be.json);",
                  "if (pm.response.code === 200 || pm.response.code === 201) { const d = pm.response.json(); pm.environment.set(\"userToken\", d.token); pm.test(\"Token de usuario recibido\", () => pm.expect(d.token).to.be.a(\"string\").and.not.empty); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "02 Iniciar sesión de usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Respuesta JSON\", () => pm.response.to.be.json);",
                  "if (pm.response.code === 200 || pm.response.code === 201) { const d = pm.response.json(); pm.environment.set(\"userToken\", d.token); pm.test(\"Token de usuario recibido\", () => pm.expect(d.token).to.be.a(\"string\").and.not.empty); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "03 Consultar usuario actual",
          "request": {
