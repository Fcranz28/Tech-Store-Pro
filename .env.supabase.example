# Copy to .env.supabase and fill with the project's Connect > Session pooler values.
SPRING_PROFILES_ACTIVE=supabase
DB_URL=jdbc:postgresql://POOLER_HOST:5432/postgres?sslmode=require&currentSchema=techstore
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=replace-with-database-password
JWT_SECRET=replace-with-random-secret-at-least-32-bytes
APP_FRONTEND_ORIGIN=https://YOUR_FRONTEND.vercel.app
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME
APP_PUBLIC_URL=https://YOUR_BACKEND.example.com
PORT=8080
DB_POOL_SIZE=5
# Optional first-run accounts; use different, strong passwords.
ADMIN_EMAIL=
ADMIN_PASSWORD=
OPERATOR_EMAIL=
OPERATOR_PASSWORD=
