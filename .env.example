# Copy this file to .env and set values for your local PostgreSQL instance.
DB_URL=jdbc:postgresql://localhost:5432/techstore_pro
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgresql-password
# Generate a unique random secret of at least 32 UTF-8 bytes.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
APP_FRONTEND_ORIGIN=http://localhost:4200
# Optional first-run administrator; password must be at least 12 characters.
ADMIN_EMAIL=admin@techstore.local
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
UPLOAD_DIR=./uploads/productos
APP_PUBLIC_URL=http://localhost:8080
